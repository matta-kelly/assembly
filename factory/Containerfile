# The factory's image: node, git, ssh, gh, skopeo and the podman client, then the factory itself at the version it is
# built from, its entrypoint the command line (factory/cli/index.ts). It is built from the repo's root. The factory runs
# here, never on the host. It starts its attempts' containers through the host's podman socket, so every path it hands
# podman is a host path, mounted at the same path in here. It lands each cl with crate, the host's install mounted
# read-only, and commits and pushes as Matt, his name and his GH_TOKEN given by whoever runs it (the server's Quadlet).
# trixie, for git 2.47: crate's hooks pick a change onto main with `cherry-pick --empty` (git 2.45 and later), and a land
# target on this machine (the e2e's) runs them with this git.
FROM docker.io/library/node:22.23.4-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git openssh-client skopeo \
  && rm -rf /var/lib/apt/lists/*

# podman-remote, the client only, pinned by version and by the release's sha256.
ARG PODMAN=6.1.4
ARG PODMAN_SHA256=af1f85c22214088a0a9986b9c82b4c9b5b74eda8ecaa6c8cca82b1a63f339b4a
RUN curl -fsSL -o /tmp/podman.tgz "https://github.com/containers/podman/releases/download/v${PODMAN}/podman-remote-static-linux_amd64.tar.gz" \
  && echo "${PODMAN_SHA256}  /tmp/podman.tgz" | sha256sum -c - \
  && tar -xzf /tmp/podman.tgz -C /tmp \
  && install /tmp/bin/podman-remote-static-linux_amd64 /usr/local/bin/podman \
  && rm -rf /tmp/podman.tgz /tmp/bin

# gh, pinned by version and by the release's sha256: git-land's gate and git's credential helper, from GH_TOKEN.
ARG GH=2.103.3
ARG GH_SHA256=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d
RUN curl -fsSL -o /tmp/gh.tgz "https://github.com/cli/cli/releases/download/v${GH}/gh_${GH}_linux_amd64.tar.gz" \
  && echo "${GH_SHA256}  /tmp/gh.tgz" | sha256sum -c - \
  && tar -xzf /tmp/gh.tgz -C /tmp \
  && install "/tmp/gh_${GH}_linux_amd64/bin/gh" /usr/local/bin/gh \
  && rm -rf /tmp/gh.tgz "/tmp/gh_${GH}_linux_amd64"

ENV CONTAINER_HOST=unix:///run/podman/podman.sock

# ssh to `localhost` is ssh to the host: a repo's remote on crate is core@localhost when crate is on the same machine,
# and in here localhost is the container. The host key stays localhost's, so the host's known_hosts holds for it.
RUN printf 'Host localhost\n  HostName host.containers.internal\n  HostKeyAlias localhost\n' > /etc/ssh/ssh_config.d/host.conf

# crate, the host's install, is mounted read-only here, so the orchestrator makes each dev repo's image with it.
ENV PATH=/usr/local/share/crate/bin:$PATH

# The factory, at the version it is built from: its runtime packages, then its code. The role notes and type notes are
# read from beside the code (workspace/, work/types/), so they ship with it.
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY factory factory
COPY workspace workspace
COPY work/types work/types
ARG VERSION=dev
ENV ASSEMBLY_VERSION=$VERSION
# `factory`: the command line by name, for the entrypoint and for `podman exec <container> factory <verb>`, the door's way in
RUN printf '#!/bin/sh\nexec node --disable-warning=ExperimentalWarning /app/factory/cli/index.ts "$@"\n' > /usr/local/bin/factory \
  && chmod 755 /usr/local/bin/factory
USER node
ENTRYPOINT ["factory"]
