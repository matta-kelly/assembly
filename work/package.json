{
  "name": "@mku1tra/work",
  "version": "0.0.0-development",
  "description": "The types of the work, on basis: objective, issue, plan and cl, each with a type note that says what each part of its notes holds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matta-kelly/assembly.git",
    "directory": "work"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "types",
    "!types/basis.config.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@mku1tra/basis": "^0.30.0",
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
