# The orchestrator's image: node, git, and the podman client. The orchestrator runs here, never on the host. It starts
# its attempts' containers through the host's podman socket, so every path it hands podman is a host path, mounted at
# the same path in here.
FROM docker.io/library/node:22.23.4-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/*

# podman-remote, the client only, pinned by version and by the release's sha256.
ARG PODMAN=6.1.4
ARG PODMAN_SHA256=af1f85c22214088a0a9986b9c82b4c9b5b74eda8ecaa6c8cca82b1a63f339b4a
RUN curl -fsSL -o /tmp/podman.tgz "https://github.com/containers/podman/releases/download/v${PODMAN}/podman-remote-static-linux_amd64.tar.gz" \
  && echo "${PODMAN_SHA256}  /tmp/podman.tgz" | sha256sum -c - \
  && tar -xzf /tmp/podman.tgz -C /tmp \
  && install /tmp/bin/podman-remote-static-linux_amd64 /usr/local/bin/podman \
  && rm -rf /tmp/podman.tgz /tmp/bin

ENV CONTAINER_HOST=unix:///run/podman/podman.sock
ENV GIT_AUTHOR_NAME=assembly GIT_AUTHOR_EMAIL=assembly@localhost GIT_COMMITTER_NAME=assembly GIT_COMMITTER_EMAIL=assembly@localhost
