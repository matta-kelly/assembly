{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "orchestrator",
    "process",
    "workspace",
    "effects",
    "main.ts",
    "main.test.ts",
    "cli",
    "scripts",
    "schema.ts",
    "basis.config.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ]
}
