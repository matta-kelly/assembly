#!/usr/bin/env bash
# A push of assembly goes out only when every note fits its type: `just check`, the same check the pipeline runs.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! just check; then
  echo "Refused: just check failed. Fix it, or push with --no-verify to skip this once." >&2
  exit 1
fi
